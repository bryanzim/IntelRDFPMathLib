# Formatting taken from LIBRARY/src, not an external style guide.
# Most sources use 2-space indents, braces attached to the signature,
# and pointers written as `type *name`.
---
Language: Cpp
LineEnding: LF
BasedOnStyle: LLVM
IndentWidth: 2
TabWidth: 2
UseTab: Never
ContinuationIndentWidth: 4
ColumnLimit: 0
BreakBeforeBraces: Attach
PointerAlignment: Right
DerivePointerAlignment: false
SpaceBeforeParens: Custom
SpaceBeforeParensOptions:
  AfterControlStatements: false
  AfterFunctionDefinitionName: false
  AfterFunctionDeclarationName: false
AlignTrailingComments: true
SortIncludes: Never
InsertBraces: false
Standard: c++17
...
