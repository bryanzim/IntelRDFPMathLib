#include <stdio.h>
#include <stdlib.h>
#include "decimal.h"
#include "example_shim.h"

int main(int argc, char** argv) {
  (void)argc;
  (void)argv;
  Decimal128 x, y, z;
  _IDEC_round my_rnd_mode = _IDEC_nearesteven;
  _IDEC_flags my_fpsf = _IDEC_allflagsclear;

  printf("Begin Decimal Floating-Point Sanity Check\n");
  fflush(stdout);

  /* 2 * 3 = 6 (matches readtest_smoke.in) */
  x.w[HIGH_128W] = 0x3040000000000000ull;
  x.w[LOW_128W] = 0x0000000000000002ull;
  y.w[HIGH_128W] = 0x3040000000000000ull;
  y.w[LOW_128W] = 0x0000000000000003ull;
  z = example_bid128_mul(x, y, my_rnd_mode, &my_fpsf);
  if (z.w[HIGH_128W] != 0x3040000000000000ull || z.w[LOW_128W] != 0x0000000000000006ull ||
      my_fpsf != _IDEC_allflagsclear) {
    return EXIT_FAILURE;
  }

  printf("End Decimal Floating-Point Sanity Check\n");
  fflush(stdout);
  return EXIT_SUCCESS;
}
