root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{bat,cmd}]
end_of_line = crlf

[*.md]
trim_trailing_whitespace = false

# Matches the dominant indent in LIBRARY/src.
[*.{c,h,cc,cpp,cxx,hpp,hh,hxx}]
indent_style = space
indent_size = 2
