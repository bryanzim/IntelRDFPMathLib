# Identifier case is not enforced.
# This tree mixes snake_case with existing spellings such as unpack_BID64,
# QH, Stemp, BID_UINT64, and macros (UPPER_CASE, P_/G_ prefixes, big_endian,
# and leading underscores). Forcing one case flags the same headers in every
# translation unit.
---
Checks: >
  -*,
  readability-identifier-naming

WarningsAsErrors: ''
HeaderFilterRegex: '(LIBRARY|TESTS|EXAMPLES)/.*'
FormatStyle: file

CheckOptions:
  - key: readability-identifier-naming.NamespaceCase
    value: aNy_CasE
  - key: readability-identifier-naming.FunctionCase
    value: aNy_CasE
  - key: readability-identifier-naming.MethodCase
    value: aNy_CasE
  - key: readability-identifier-naming.VariableCase
    value: aNy_CasE
  - key: readability-identifier-naming.ParameterCase
    value: aNy_CasE
  - key: readability-identifier-naming.MemberCase
    value: aNy_CasE
  - key: readability-identifier-naming.ClassMemberCase
    value: aNy_CasE
  - key: readability-identifier-naming.ConstantCase
    value: aNy_CasE
  - key: readability-identifier-naming.GlobalConstantCase
    value: aNy_CasE
  - key: readability-identifier-naming.StaticConstantCase
    value: aNy_CasE
  - key: readability-identifier-naming.MacroDefinitionCase
    value: aNy_CasE
  - key: readability-identifier-naming.ClassCase
    value: aNy_CasE
  - key: readability-identifier-naming.StructCase
    value: aNy_CasE
  - key: readability-identifier-naming.EnumCase
    value: aNy_CasE
  - key: readability-identifier-naming.EnumConstantCase
    value: aNy_CasE
  - key: readability-identifier-naming.TypedefCase
    value: aNy_CasE
  - key: readability-identifier-naming.TypeAliasCase
    value: aNy_CasE
  - key: readability-identifier-naming.NamespaceIgnoredRegexp
    value: '^_.*'
  - key: readability-identifier-naming.FunctionIgnoredRegexp
    value: '^_.*'
  - key: readability-identifier-naming.MethodIgnoredRegexp
    value: '^_.*'
  - key: readability-identifier-naming.VariableIgnoredRegexp
    value: '^_.*'
  - key: readability-identifier-naming.ParameterIgnoredRegexp
    value: '^_.*'
  - key: readability-identifier-naming.MemberIgnoredRegexp
    value: '^_.*'
  - key: readability-identifier-naming.ClassMemberIgnoredRegexp
    value: '^_.*'
  - key: readability-identifier-naming.ConstantIgnoredRegexp
    value: '^_.*'
  - key: readability-identifier-naming.GlobalConstantIgnoredRegexp
    value: '^_.*'
  - key: readability-identifier-naming.StaticConstantIgnoredRegexp
    value: '^_.*'
  - key: readability-identifier-naming.ClassIgnoredRegexp
    value: '^_.*'
  - key: readability-identifier-naming.StructIgnoredRegexp
    value: '^_.*'
  - key: readability-identifier-naming.UnionIgnoredRegexp
    value: '^_.*'
  - key: readability-identifier-naming.EnumIgnoredRegexp
    value: '^_.*'
  - key: readability-identifier-naming.EnumConstantIgnoredRegexp
    value: '^_.*'
  - key: readability-identifier-naming.TypedefIgnoredRegexp
    value: '^_.*'
  - key: readability-identifier-naming.TypeAliasIgnoredRegexp
    value: '^_.*'
  - key: readability-identifier-naming.MacroDefinitionIgnoredRegexp
    value: '.*'
